# CRTC local secrets template.
#
# Copy this file to .streamlit/secrets.toml (same folder) and fill in only
# the keys for the integrations you're actually testing. .streamlit/secrets.toml
# is already in .gitignore — it will never be committed. Never paste real
# values into this .example file.
#
# Every integration in this app fails safe when its secrets are missing:
# the feature shows a "not configured" message instead of crashing, so you
# can leave any section below blank and still run the app.

# --- Login + persistence (Google Apps Script + Sheet) — see AUTH_SETUP.md / DEPLOY.md ---
APPS_SCRIPT_URL = ""
APPS_SCRIPT_TOKEN = ""

# --- Shared Admin login (the two owners) — see AUTH_SETUP.md ---
# CRTC_ADMIN_PASSWORD_HASH must be the SHA-256 hex digest of your password,
# e.g.: python3 -c "import hashlib; print(hashlib.sha256(b'your-password').hexdigest())"
CRTC_ADMIN_USERNAME = ""
CRTC_ADMIN_PASSWORD_HASH = ""

# --- AI Analyzer + AI listing enrichment (Anthropic) ---
ANTHROPIC_API_KEY = ""

# --- eBay Browse / search-by-image / comps ---
EBAY_CLIENT_ID = ""
EBAY_CLIENT_SECRET = ""

# --- Stripe (subscription paywall + POS) — see DEPLOY.md ---
STRIPE_SECRET_KEY = ""
STRIPE_PAYMENT_LINK_URL = ""
APP_URL = ""

# --- Gmail (Invoice Import / mail parsing) ---
GMAIL_ADDRESS = ""
GMAIL_APP_PASSWORD = ""

# Note: STRIPE_WEBHOOK_SECRET is NOT a Streamlit secret — stripe_webhook_server.py
# runs as its own process and reads it as a plain OS environment variable.
# See LOCAL_DEV.md for how to run that service locally.
